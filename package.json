{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "scripts": {
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/helpdesk-admin run dev",
    "dev:mobile": "pnpm --filter @workspace/helpdesk-mobile run dev",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.15.0"
  },
  "devDependencies": {
    "@types/node": "^18.18.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  }
}
