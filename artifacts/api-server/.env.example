# Copia a `.env` en la raíz del monorepo O aquí en artifacts/api-server.
# El loader de api-server busca .env subiendo directorios (ver src/load-env.ts).

# URL de Postgres en Railway (pestaña Variables del servicio Postgres → DATABASE_URL, o Connect).
# El host público suele ser postgres-production-3776.up.railway.app — copia usuario/contraseña/puerto desde la variable DATABASE_URL del Postgres en Railway (no inventes).
DATABASE_URL=postgresql://USER:PASSWORD@postgres-production-3776.up.railway.app:5432/railway

# Misma cadena que en producción; mínimo 16 caracteres aleatorios
JWT_SECRET=

# Puerto local del Express api-server (Railway suele usar PORT que asigna la plataforma)
API_PORT=3001
