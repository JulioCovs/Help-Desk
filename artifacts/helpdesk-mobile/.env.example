# Copia a `.env` en esta carpeta (no lo subas a git). Expo carga EXPO_PUBLIC_* automáticamente.
# Apunta al api-server (Express), NUNCA al host de Postgres.

# --- Local ---
# Simulador iOS / Expo web en la misma Mac:
EXPO_PUBLIC_API_URL=http://localhost:3001
# Android Emulator:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# Teléfono físico (Expo Go), misma WiFi que la Mac — sustituye por tu IP local:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# --- Railway (producción) ---
# EXPO_PUBLIC_API_URL=https://help-desk-production-c1fd.up.railway.app
